# Kalshi API
KALSHI_API_KEY=your_kalshi_api_key
KALSHI_PRIVATE_KEY_PATH=path/to/kalshi_private_key.pem
KALSHI_ENV=demo  # demo or prod

# Polymarket API
POLYMARKET_PRIVATE_KEY=your_ethereum_private_key
POLYMARKET_API_KEY=your_poly_api_key
POLYMARKET_API_SECRET=your_poly_api_secret
POLYMARKET_API_PASSPHRASE=your_poly_api_passphrase

# Claude API (for news analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key

# News APIs
NEWS_API_KEY=your_newsapi_key

# Polymarket API
POLYMARKET_PRIVATE_KEY=your_ethereum_private_key
POLYMARKET_API_KEY=your_poly_api_key
POLYMARKET_API_SECRET=your_poly_api_secret
POLYMARKET_API_PASSPHRASE=your_poly_api_passphrase
POLYMARKET_USER_ADDRESS=your_proxy_wallet_for_balance_lookup

# Polymarket copy trading
AGENT_ENABLE_POLYMARKET_COPY=true
AGENT_ENABLE_POLYMARKET_NEWS=false
POLY_COPY_LEADERS=0xleader_wallet_1,0xleader_wallet_2
POLY_COPY_POLL_INTERVAL=15
POLY_COPY_MAX_LAG_SECONDS=120
POLY_COPY_SIZING_MODE=fixed_usd
POLY_COPY_FIXED_USD=25
POLY_COPY_MAX_SLIPPAGE=0.02
POLY_COPY_MAX_POSITIONS_PER_LEADER=5
POLY_COPY_MAX_DAILY_LOSS_PER_LEADER=100

# Trading Config
PAPER_MODE=true
INITIAL_BALANCE=10000
MAX_POSITION_PCT=0.02
MAX_EXPOSURE_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.05
STOP_LOSS_PCT=0.05

# Runtime toggles for milestone-1 paper-mode testing
AGENT_ENABLE_BTC15M=true
AGENT_ENABLE_POLYMARKET_NEWS=false
AGENT_ENABLE_POLYMARKET_COPY=false
AGENT_ENABLE_STOCKS_ETF_SHELL=false

# BTC15M / day-trader thresholds
# Defaults are production-strict. For paper observation of fills, temporarily lower:
#   BTC15M_MIN_VS_STRIKE_PCT=0.0003
#   BTC15M_MIN_NET_EDGE=0.03
#   BTC15M_MIN_CONFIDENCE=0.50
#   DAY_TRADER_MIN_VOLUME=500
BTC15M_MIN_VS_STRIKE_PCT=0.0008
BTC15M_MIN_NET_EDGE=0.08
BTC15M_MIN_CONFIDENCE=0.60
DAY_TRADER_MIN_EDGE=0.05
DAY_TRADER_MIN_CONFIDENCE=0.55
DAY_TRADER_MIN_VOLUME=2000

# Dashboard
API_HOST=0.0.0.0
API_PORT=8000

# Daily P&L report (scripts/run_daily_pnl_report.py)
DAILY_REPORT_TELEGRAM=true
DAILY_REPORT_HOUR_UTC=9
DAILY_REPORT_OUTPUT_DIR=logs/reports

# Swarm / graph features
SWARM_ENABLED=false
ZEP_API_KEY=
SWARM_LLM_API_KEY=
SWARM_LLM_BASE_URL=https://api.openai.com/v1
SWARM_LLM_MODEL_NAME=gpt-4o-mini
